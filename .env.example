# ========================================================
# Настройки приложения Шежіре (altybayev.kz)
# Скопируйте этот файл в .env в панели Plesk или по SSH
# ========================================================

APP_NAME="Шежіре Алтыбаевтар"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://altybayev.kz
APP_SECRET=replace_with_random_32_characters_secret_key

# Подключение к базе данных MySQL / MariaDB в Plesk
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=altybayev_shezhire
DB_USER=altybayev_user
DB_PASS=your_database_password_here
DB_CHARSET=utf8mb4

# Авторизация через Google OAuth 2.0
# Получите в Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX_your_client_secret
GOOGLE_REDIRECT_URI=https://altybayev.kz/auth/google/callback

# Главный администратор (полный доступ, управление редакторами и аудит)
SUPER_ADMIN_EMAIL=zhandos.alt06@gmail.com

# Язык по умолчанию (kk - казахский, ru - русский)
DEFAULT_LOCALE=kk

# Путь для загрузки фотографий
UPLOAD_DIR=public/uploads
MAX_UPLOAD_SIZE_MB=15
