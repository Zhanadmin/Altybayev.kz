# Environment
.env

# Dependencies
/vendor/

# Uploads & User Media (keep directory structure)
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess
!/public/uploads/web.config
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Imports & GEDCOM files (confidential family data)
/import/
*.ged

# OS / Editor files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp

.claude/

# ALT-044: кеш версии сайта (создаётся на сервере)
/storage/version.json

# Бэкапы БД (содержат данные — не выкладывать)
*_backup*.sql
*_backup*.sql.gz
*.bak.sql
/database/backups/

# Временные файлы агента
storage/tok_check*.php
storage/tmp_*.txt
storage/lint_*.txt
tmp_*
/tmp/
