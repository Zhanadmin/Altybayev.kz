<IfModule mod_rewrite.c>
    RewriteEngine On

    # Обработка заголовка Authorization
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Если запрошенный файл или папка существуют в public, отдаем напрямую
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Все остальные запросы направляем на точку входа index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Отключение листинга файлов
Options -Indexes

# Защита служебных файлов
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Настройки безопасности и сжатия
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
