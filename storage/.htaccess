# TASK-018: хранилище (альбомы, медиа, логи) недоступно напрямую из веба.
# Файлы выдаются только через /album/media и /media/stream после входа.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
