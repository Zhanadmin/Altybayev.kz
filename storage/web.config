<?xml version="1.0" encoding="UTF-8"?>
<!-- TASK-018: хранилище недоступно напрямую (IIS / Plesk на Windows). Файлы выдаёт приложение после входа. -->
<configuration>
    <system.webServer>
        <handlers accessPolicy="None" />
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="uploads" />
                    <add segment="logs" />
                    <add segment="backups" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>
